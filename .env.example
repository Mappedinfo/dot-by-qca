QODER_SITE=global
QODER_PAT=

# Optional, for Mac execution and the DSH taskbook.
# DOT_DSH_BIN=/path/to/dsh
# DOT_DSH_WEB_STATUS=/path/to/dsh-web.sh

# Optional, for approval reminders through a QCA Forward manual Schedule.
# DOT_QCA_APPROVAL_SCHEDULE_ID=
